# ── Database (Neon) ───────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# ── Server ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Set this to your Railway public URL after first deploy, e.g.:
# CLIENT_URL=https://school-management-production.up.railway.app
CLIENT_URL=https://your-app.up.railway.app

# ── JWT (use long random strings in production) ───────────────────
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_STRING_32_CHARS
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ── Bcrypt ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Email (optional — for password reset) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="School Management <noreply@school.com>"

# ── File Uploads ──────────────────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Account Lock ──────────────────────────────────────────────────
MAX_FAILED_LOGINS=5
LOCK_DURATION_MINUTES=30
